+          }
+        }
+      }
+    }
+  }
+
+  // done with I/O
+  for (uint16_t file_num = 0; file_num < l->file_count; file_num++) {
+    _openslide_dicom_io_suspend(l->files[file_num]->dio);
+  }
+  return true;
