+      (length >= CACHE_BLOCK_SIZE ||
+       dio->virt_offset < dio->phys_offset ||
+       dio->virt_offset - dio->phys_offset > CACHE_BLOCK_SIZE - CACHE_BLOCK_MIN_RELOAD)) {
+    cache_debug("seek %s%"PRId64,
+                dio->virt_offset > dio->phys_offset ? "+" : "",
